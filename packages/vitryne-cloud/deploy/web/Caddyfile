# The editor's static build with the cross-origin isolation headers it needs (docs/HOSTING.md).
# Plain HTTP on :80; HTTPS is the proxy's in front (Coolify, Traefik, nginx). The backend
# (docs/CLOUD.md) is SUPABASE_URL; entrypoint.sh doesn't start without it.
{
	admin off
}

:80 {
	encode zstd gzip
	header {
		Cross-Origin-Opener-Policy same-origin
		Cross-Origin-Embedder-Policy require-corp
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}

	# The editor reads this at start: no file (404) means no backend, which it says.
	@cloud expression `{env.SUPABASE_URL} != "" && {env.SUPABASE_PUBLISHABLE_KEY} != ""`
	handle /config.json {
		header Cache-Control no-cache
		handle @cloud {
			header Content-Type application/json
			respond `{"backend":{"url":"{$SUPABASE_URL}","publishableKey":"{$SUPABASE_PUBLISHABLE_KEY}"},"privacyPolicy":"/privacy.html"}`
		}
		respond 404
	}
	# The operator's details come from the environment.
	handle /privacy.html {
		root * /srv/site
		templates
		file_server
	}
	handle {
		root * /srv/app
		file_server
	}
}
