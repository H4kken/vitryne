# Settings for docker-compose.yml next to this file (packages/vitryne-docs/content/docs/developers/cloud.md). Copy to .env in this
# folder; only the two Supabase keys are required. Never commit .env.

# The release to run (a version like 0.1.0, see the GitHub releases). Empty: the compose file's
# default, `latest` or the release it came with.
VITRYNE_VERSION=

# The port it listens on (plain HTTP; on a server, put your HTTPS proxy in front).
HTTP_PORT=8000

# Required: a Supabase project (Project Settings, API Keys). The publishable key
# (sb_publishable_...) only: the browser gets it. Never put a secret key here.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Optional: apply packages/vitryne-cloud/supabase/migrations at start (Connect, "Session pooler"
# connection string). Without it, run `pnpm run supabase db push` from packages/vitryne-web/
# after a schema change.
SUPABASE_DB_URL=
