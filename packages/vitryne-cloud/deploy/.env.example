# Optional settings for docker-compose.yml next to this file (docs/CLOUD.md). Copy to .env in
# this folder; every line can stay empty. Never commit .env.

# The release to run (a version like 0.1.0, see the GitHub releases). Empty: the compose file's
# default, `latest` or the release it came with.
VITRYNE_VERSION=

# Where it listens. On a server with a domain: SITE_ADDRESS=vitryne.example.org, HTTP_PORT=80,
# HTTPS_PORT=443, and Caddy gets the certificate. Behind Coolify or another proxy: keep ":80".
SITE_ADDRESS=:80
HTTP_PORT=8000
HTTPS_PORT=8443

# Cloud mode: a Supabase project (Project Settings, API Keys). The publishable key
# (sb_publishable_...) only: the browser gets it. Never put a secret key here.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Optional: apply packages/vitryne-cloud/supabase/migrations at start (Connect, "Session pooler"
# connection string). Without it, run `pnpm run supabase db push` from packages/vitryne-web/
# after a schema change.
SUPABASE_DB_URL=

# Shown on /privacy.html (GDPR: who runs the service and how to reach them): your name or
# company, an email for privacy requests, where the data is (e.g. "Supabase, EU (Frankfurt)").
OPERATOR_NAME=
OPERATOR_CONTACT=
OPERATOR_HOSTING=
