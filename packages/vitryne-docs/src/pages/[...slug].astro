---
// SPDX-License-Identifier: AGPL-3.0-or-later
// Every docs page, one static HTML file per page and language (lib/i18n.ts), and a redirect
// for each folder URL without a page (`/guide` to the folder's first page).
import { render } from "astro:content";
import Redirect from "@/components/redirect.astro";
import Shell from "@/components/shell.astro";
import { Card } from "@/components/card";
import defaultMdxComponents from "fumadocs-ui/mdx";
import "@/styles/global.css";
import {
  source,
  getFolderRedirects,
  getLocalizedPages,
  getPageImageUrl,
} from "@/lib/source";
import Layout from "@/components/layout.astro";
import type { TOCItemType } from "fumadocs-core/toc";

export async function getStaticPaths() {
  return [
    ...getLocalizedPages().map(({ language, page, slug }) => ({
      params: { slug },
      props: { language, page },
    })),
    ...getFolderRedirects().map(({ slug, to }) => ({
      params: { slug },
      props: { redirect: to },
    })),
  ];
}

const props = Astro.props;
const { language, page } = props;
const rendered = page && (await render(page.data._raw));
const isHome = page?.slugs.length === 0;
const title = isHome ? "Vitryne docs" : `${page?.data.title} · Vitryne docs`;

const toc: TOCItemType[] = (rendered?.headings ?? []).map((heading) => ({
  depth: heading.depth,
  title: heading.text,
  url: "#" + heading.slug,
}));
const Content = rendered?.Content;
---

{props.redirect !== undefined && <Redirect to={props.redirect} />}
{page && language && Content && (
  <Layout lang={language}>
    <Fragment slot="head">
      <title>{title}</title>
      <meta name="title" content={title} />
      <meta name="description" content={page.data.description} />
      <meta property="og:image" content={getPageImageUrl(page)} />
    </Fragment>
    <Shell tree={source.getPageTree(language)} lang={language} toc={toc}>
      <h1 class="font-display font-semibold text-3xl">{page.data.title}</h1>
      <p class="text-lg text-fd-muted-foreground mb-8">
        {page.data.description}
      </p>
      <div class="prose flex-1">
        <Content components={{ ...defaultMdxComponents, Card }} />
      </div>
    </Shell>
  </Layout>
)}
