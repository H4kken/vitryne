---
// SPDX-License-Identifier: AGPL-3.0-or-later
// Every docs page, one static HTML file per page and language (lib/i18n.ts).
import { render } from "astro:content";
import { Docs } from "@/components/docs";
import { Card } from "@/components/card";
import defaultMdxComponents from "fumadocs-ui/mdx";
import "@/styles/global.css";
import { source, getLocalizedPages, getPageImageUrl } from "@/lib/source";
import Layout from "@/components/layout.astro";
import type { TOCItemType } from "fumadocs-core/toc";

export async function getStaticPaths() {
  return getLocalizedPages().map(({ language, page, slug }) => ({
    params: { slug },
    props: { language, page },
  }));
}

const { language, page } = Astro.props;
const entry = page.data._raw;
const { Content, headings } = await render(entry);
const image = getPageImageUrl(page);
const isHome = page.slugs.length === 0;
const title = isHome ? "Vitryne docs" : `${page.data.title} · Vitryne docs`;

const toc: TOCItemType[] = headings.map((heading) => ({
  depth: heading.depth,
  title: heading.text,
  url: "#" + heading.slug,
}));
---

<Layout lang={language}>
  <Fragment slot="head">
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={page.data.description} />
    <meta property="og:image" content={image} />
  </Fragment>
  <Docs
    tree={source.getPageTree(language)}
    lang={language}
    pathname={Astro.url.pathname}
    params={Astro.params}
    page={{ toc }}
    client:load
  >
    <h1 class="font-display font-semibold text-3xl">{page.data.title}</h1>
    <p class="text-lg text-fd-muted-foreground mb-8">{page.data.description}</p>
    <div class="prose flex-1">
      <Content components={{ ...defaultMdxComponents, Card }} />
    </div>
  </Docs>
</Layout>
