# Large binary assets go through Git LFS (CONTRIBUTING.md, "Large files"). ./check rejects any
# other tracked file over 1 MiB. Generated data (SDF bakes, bench output) is not committed at all.
*.glb   filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.fbx   filter=lfs diff=lfs merge=lfs -text
*.exr   filter=lfs diff=lfs merge=lfs -text
*.hdr   filter=lfs diff=lfs merge=lfs -text
*.mp4   filter=lfs diff=lfs merge=lfs -text
*.webm  filter=lfs diff=lfs merge=lfs -text
# Example projects stay plain files so a clone (or a GitHub zip download) opens them without
# git-lfs: their avatar mesh is under the 1 MiB rule, like assets/body's OBJ. So does the drawn
# skirt the golden suite drapes (the same mesh, so the same blob).
assets/examples/**/*.glb -filter -diff -merge binary
packages/vitryne-engine/tests/**/*.glb -filter -diff -merge binary
