# Optional settings for deploy/docker-compose.yml (docs/CLOUD.md). Copy to deploy/.env; every
# line can stay empty. Never commit .env.

# Where it listens. On a server with a domain: SITE_ADDRESS=vitryne.example.org, HTTP_PORT=80,
# HTTPS_PORT=443, and Caddy gets the certificate. Behind Coolify or another proxy: keep ":80".
SITE_ADDRESS=:80
HTTP_PORT=8000
HTTPS_PORT=8443

# Cloud mode: a Supabase project (Project Settings, API Keys). The publishable key
# (sb_publishable_...) only: the browser gets it. Never put a secret key here.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Optional: apply supabase/migrations at start (Connect, "Session pooler" connection string).
# Without it, run `pnpm run supabase db push` from app/ after a schema change.
SUPABASE_DB_URL=

# Shown on /privacy.html (GDPR: who runs the service and how to reach them): your name or
# company, an email for privacy requests, where the data is (e.g. "Supabase, EU (Frankfurt)").
OPERATOR_NAME=
OPERATOR_CONTACT=
OPERATOR_HOSTING=
